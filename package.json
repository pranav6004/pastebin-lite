{
  "name": "pastebin-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "db:setup": "node --env-file-if-exists=.env db/setup.js",
    "test": "node --test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16"
  }
}
